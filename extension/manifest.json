{
  "manifest_version": 3,
  "name": "Open Claude in Chrome",
  "version": "1.0.0.1",
  "description": "Claude in Chrome, open source (fork jasir: bez nahrávače, více prohlížečů paralelně).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "debugger",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabGroups",
    "windows",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Claude in Chrome"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
